# ==============================================================================
# TRJTA 24 - Git Ignore Configuration
# ==============================================================================

# Environment Variables & Kredensial Sensitif
.env
.env.local
.env.*
!.env.example

# Node & Build Artifacts (jika menggunakan tooling/bundler)
node_modules/
dist/
build/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# System & OS Files
.DS_Store
Thumbs.db
desktop.ini

# Code Editor & IDE Configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Temporary & Testing Scripts
scratch/
