# ==============================================================================
# TRJTA 24 — Environment Variables Example
# ==============================================================================
# Gunakan file ini sebagai template konfigurasi lokal atau deployment.
# Salin file ini menjadi .env:
# cp .env.example .env
#
# PENTING:
# 1. HANYA gunakan 'anon' public key di frontend.
# 2. JANGAN PERNAH memasukkan Supabase 'service_role' key ke file ini atau ke frontend!
# 3. File .env asli telah diabaikan oleh .gitignore dan tidak boleh di-commit.
# ==============================================================================

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
